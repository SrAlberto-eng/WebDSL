pagina MiSitio {
  variables: nombre, descripcion

  encabezado {
    estilo: fondo-primario, centrado
    titulo: "Bienvenido"
    subtitulo: "Sistema de ejemplo"
  }

  seccion principal {
    estilo: relleno
    texto: "Contenido principal"
    boton {
      texto: "Ver más"
      enlace: "#principal"
    }
  }

  pie {
    estilo: fondo-oscuro, centrado
    texto: "© 2025 MiSitio"
  }
}
